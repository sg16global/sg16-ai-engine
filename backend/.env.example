# === SG16 sovereign stack (100% Railway) ===
# Site, Postgres, users, and Ollama brain all run on Railway (Dockerfile).
# Add Railway Postgres plugin and copy DATABASE_URL here.

# Sovereign brain — Mistral on local Ollama inside the same Railway service
SG16_BRAIN=ollama
OLLAMA_URL=http://127.0.0.1:11434
SG16_OLLAMA_MODEL=mistral:7b-instruct
SG16_CHAT_TIMEOUT_MS=120000
SG16_CODING_TIMEOUT_MS=180000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: https://sg16engine.com  https://www.sg16engine.com  http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
SG16_DEV_AUTH=0

# Owner gate — required in production (Google sign-in email must match exactly)
SG16_OWNER_EMAIL=
# Dev-only: widen Personal Developer room scopes (never enabled in production)
# SG16_INTERNAL_MODE=1

# Public site URL (OpenRouter referrer + PWA)
SG16_APP_URL=https://sg16engine.com

# Launch mode — full access, checkout disabled (set 0 when billing goes live)
SG16_LAUNCH_FREE=1
SG16_CONTACT_EMAIL=contact@sg16engine.com
SG16_SHIELD_HOST=shield.sg16engine.com

# SG16 Children World (sg16children.com) — sovereign brain child platform
# Comma-separated browser origins allowed to call /api/sg16/* (CORS)
# SG16_CHILDREN_ORIGINS=http://127.0.0.1:8787
# Comma-separated X-SG16-Client values accepted on chat routes (production)
# SG16_CHILDREN_CLIENT_IDS=sg16-children-world
SG16_CHILDREN_CHAT_TIMEOUT_MS=120000

# PostgreSQL — required for production (Railway: add Postgres plugin, copy DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/sg16
# PGSSLMODE=disable

# Railway sets PORT automatically
PORT=8000
HOST=0.0.0.0

# Optional rented-API fallback (not used when SG16_BRAIN=ollama unless SG16_SOVEREIGN_FALLBACK=1)
# SG16_AI_API_KEY=
# SG16_ROUTER_API_KEY=
# XAI_API_KEY=
# SG16_OPENROUTER_API_KEY=

SG16_LIVE_SEARCH=1

# Image edit/generate (optional — without these, analyze still works)
SG16_POLLINATIONS_API_KEY=
SG16_IMAGE_API_KEY=

# Payments — Paddle removed. Wire Dodo (or next provider) here when account is active.
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_PRICE_ID_STUDENT=
# DODO_PRICE_ID_PRO=
