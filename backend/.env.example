# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: https://sg16engine.com  https://www.sg16engine.com  http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
SG16_DEV_AUTH=0

# Public site URL (OpenRouter referrer + PWA)
SG16_APP_URL=https://sg16engine.com

# Launch mode — full access, checkout disabled (set 0 when billing goes live)
SG16_LAUNCH_FREE=1
SG16_CONTACT_EMAIL=contact@sg16engine.com

# PostgreSQL — required for production (Railway: add Postgres plugin, copy DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/sg16
# PGSSLMODE=disable

# Railway sets PORT automatically
PORT=8000

SG16_AI_API_KEY=
SG16_ROUTER_API_KEY=
SG16_LIVE_SEARCH=1

# Speed mode (default ON) — Groq first for fast chat/coding, Grok as fallback when both keys set
SG16_SPEED_MODE=speed
# Optional Grok/xAI backup when Groq is rate-limited
# XAI_API_KEY=

# Fast chat model (Groq) — small model = fastest replies
SG16_AI_MODEL_TEXT=llama-3.1-8b-instant
# Coding Hub model — stronger but still fast on Groq
SG16_AI_MODEL_CODING=llama-3.3-70b-versatile
SG16_AI_MODEL_REASONING=llama-3.3-70b-versatile
SG16_AI_MODEL_FALLBACKS=llama-3.3-70b-versatile,gemma2-9b-it
SG16_AI_MODEL_CODING_FALLBACKS=llama-3.1-8b-instant

# OpenRouter backup when Groq/Grok busy
SG16_OPENROUTER_API_KEY=
SG16_BACKUP_MODEL_VISION=meta-llama/llama-3.2-11b-vision-instruct:free

# Image edit/generate (optional — without these, analyze still works)
SG16_POLLINATIONS_API_KEY=
SG16_IMAGE_API_KEY=

# SG16 Billing Room — Dodo (same API for every SG16 app)
# SG16_BILLING_PROVIDER=dodo
# DODO_PAYMENTS_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_ENVIRONMENT=test_mode
# DODO_PRODUCT_ID_PRO=
# DODO_PRODUCT_ID_STUDENT=
# Webhook URL: https://sg16engine.com/api/v1/billing/webhook
