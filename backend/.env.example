# === AI connection — any company's OpenAI-compatible API ===
# AI_MODEL answers chat, maths and every shield; AI_CODING_MODEL answers the Coding Hub.
# Own models (Apache 2.0, on your Ollama server):
#   AI_API_URL=https://YOUR-OLLAMA-HOST/v1
#   AI_MODEL=qwen3:4b-instruct-2507-q8_0
#   AI_CODING_MODEL=qwen2.5-coder:1.5b-instruct-fp16
# Other companies (base URL → put your key in AI_API_KEY):
#   OpenAI       https://api.openai.com/v1                                  e.g. gpt-4o-mini
#   Anthropic    https://api.anthropic.com/v1                               e.g. claude-haiku-4-5
#   Google       https://generativelanguage.googleapis.com/v1beta/openai    e.g. gemini-2.5-flash
#   Groq         https://api.groq.com/openai/v1                             e.g. llama-3.1-8b-instant
#   Mistral      https://api.mistral.ai/v1                                  e.g. mistral-small-latest
#   DeepSeek     https://api.deepseek.com/v1                                e.g. deepseek-chat
#   xAI          https://api.x.ai/v1                                        e.g. grok-3-mini
#   OpenRouter   https://openrouter.ai/api/v1                               e.g. any listed model
# Check it with: npm run api:check
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_CODING_MODEL=
# Optional: a vision model on the same API, for image questions and student ID checks
# AI_VISION_MODEL=
# Optional: extra request headers as JSON, e.g. a Cloudflare Access service token in front of Ollama:
# AI_API_HEADERS={"CF-Access-Client-Id":"…","CF-Access-Client-Secret":"…"}

# Automatic fallbacks: if connection 1 fails or is busy, 2 answers, then 3 … up to 5.
# Same names with _2 … _5, e.g.:
# AI_API_URL_2=https://api.openai.com/v1
# AI_API_KEY_2=
# AI_MODEL_2=gpt-4o-mini
# AI_CODING_MODEL_2=

# Disable all old brains / fallbacks
SG16_SOVEREIGN_FALLBACK=0

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: https://sg16engine.com  https://www.sg16engine.com  http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
SG16_DEV_AUTH=0
# Preview fallback when Google OAuth fails (enabled during launch free by default)
# SG16_PREVIEW_AUTH=0

# Owner gate — required in production (Google sign-in email must match exactly)
SG16_OWNER_EMAIL=
# Dev-only: widen Personal Developer room scopes (never enabled in production)
# SG16_INTERNAL_MODE=1

# Public site URL (OpenRouter referrer + PWA)
SG16_APP_URL=https://sg16engine.com

# Launch mode — full access, checkout disabled (set 0 when billing goes live)
SG16_LAUNCH_FREE=1
SG16_CONTACT_EMAIL=contact@sg16engine.com
SG16_SHIELD_HOST=shield.sg16engine.com

# SG16 Children World — keep OFF until it has its own brain/VPS
SG16_CHILDREN_ENABLED=1
# SG16_CHILDREN_ORIGINS=http://127.0.0.1:8787
# SG16_CHILDREN_CLIENT_IDS=sg16-children-world

# PostgreSQL — required for production (Railway: add Postgres plugin, copy DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/sg16
# PGSSLMODE=disable

# Railway sets PORT automatically
PORT=8000
HOST=0.0.0.0

# Optional rented-API fallback (not used when SG16_BRAIN=ollama unless SG16_SOVEREIGN_FALLBACK=1)
# SG16_AI_API_KEY=
# SG16_ROUTER_API_KEY=
# XAI_API_KEY=
# SG16_OPENROUTER_API_KEY=

SG16_LIVE_SEARCH=1

# Image edit/generate (optional — without these, analyze still works)
SG16_POLLINATIONS_API_KEY=
SG16_IMAGE_API_KEY=

# Payments — Paddle removed. Wire Dodo (or next provider) here when account is active.
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_PRICE_ID_STUDENT=
# DODO_PRICE_ID_PRO=
