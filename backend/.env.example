# === Admin panel (/admin) ===
# Owner login. Make the hash with: npm run admin:hash   (the password itself is never stored)
# ADMIN_EMAIL=sg16global@gmail.com
ADMIN_PASSWORD_HASH=
# The AI connection below can also be set from the admin panel — panel settings win over these.

# === AI connection — any OpenAI-compatible API ===
# Set these three and the whole app (chat, coding, search, student, health, market) uses that AI.
# Examples:
#   SG16 Brain         AI_API_URL=https://mistralbrain.com/api/brain   AI_API_KEY=<sg16p_ project key>  (AI_MODEL not needed)
#   Your VPS (Ollama)  AI_API_URL=http://YOUR-VPS-IP:11434/v1   AI_MODEL=mistral:7b-instruct   (no key needed)
#   OpenAI             AI_API_URL=https://api.openai.com/v1      AI_MODEL=gpt-4o-mini
#   Groq               AI_API_URL=https://api.groq.com/openai/v1 AI_MODEL=llama-3.1-8b-instant
#   OpenRouter         AI_API_URL=https://openrouter.ai/api/v1   AI_MODEL=mistralai/mistral-7b-instruct
#   Mistral            AI_API_URL=https://api.mistral.ai/v1      AI_MODEL=mistral-small-latest
# Check it with: npm run api:check
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Optional: a vision model on the same API, for image questions and student ID checks
# AI_VISION_MODEL=

# Legacy brain (used only when AI_API_URL is empty)
SG16_BRAIN=mistralbrain
MISTRAL_BRAIN_URL=https://api.mistralbrain.com
MISTRAL_BRAIN_KEY=

# Disable all old brains / fallbacks
SG16_SOVEREIGN_FALLBACK=0

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: https://sg16engine.com  https://www.sg16engine.com  http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
SG16_DEV_AUTH=0
# Preview fallback when Google OAuth fails (enabled during launch free by default)
# SG16_PREVIEW_AUTH=0

# Owner gate — required in production (Google sign-in email must match exactly)
SG16_OWNER_EMAIL=
# Dev-only: widen Personal Developer room scopes (never enabled in production)
# SG16_INTERNAL_MODE=1

# Public site URL (OpenRouter referrer + PWA)
SG16_APP_URL=https://sg16engine.com

# Launch mode — full access, checkout disabled (set 0 when billing goes live)
SG16_LAUNCH_FREE=1
SG16_CONTACT_EMAIL=contact@sg16engine.com
SG16_SHIELD_HOST=shield.sg16engine.com

# SG16 Children World — keep OFF until it has its own brain/VPS
SG16_CHILDREN_ENABLED=1
# SG16_CHILDREN_ORIGINS=http://127.0.0.1:8787
# SG16_CHILDREN_CLIENT_IDS=sg16-children-world

# PostgreSQL — required for production (Railway: add Postgres plugin, copy DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/sg16
# PGSSLMODE=disable

# Railway sets PORT automatically
PORT=8000
HOST=0.0.0.0

# Optional rented-API fallback (not used when SG16_BRAIN=ollama unless SG16_SOVEREIGN_FALLBACK=1)
# SG16_AI_API_KEY=
# SG16_ROUTER_API_KEY=
# XAI_API_KEY=
# SG16_OPENROUTER_API_KEY=

SG16_LIVE_SEARCH=1

# Image edit/generate (optional — without these, analyze still works)
SG16_POLLINATIONS_API_KEY=
SG16_IMAGE_API_KEY=

# Payments — Paddle removed. Wire Dodo (or next provider) here when account is active.
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_PRICE_ID_STUDENT=
# DODO_PRICE_ID_PRO=
