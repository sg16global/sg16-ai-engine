# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: https://sg16engine.com  https://www.sg16engine.com  http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
SG16_DEV_AUTH=0

# Public site URL (OpenRouter referrer + PWA)
SG16_APP_URL=https://sg16engine.com

# Railway sets PORT automatically
PORT=8000

SG16_AI_API_KEY=
SG16_ROUTER_API_KEY=
SG16_LIVE_SEARCH=1

# OpenRouter backup when Groq is busy
SG16_OPENROUTER_API_KEY=
SG16_BACKUP_MODEL_VISION=google/gemini-2.0-flash-exp:free

# Google Gemini — Document Lab analysis (https://aistudio.google.com/apikey)
SG16_GEMINI_API_KEY=
SG16_GEMINI_MODEL=gemini-2.0-flash

# Image edit/generate (optional — without these, analyze still works)
SG16_POLLINATIONS_API_KEY=
SG16_IMAGE_API_KEY=

# Paddle Billing — https://vendors.paddle.com (or sandbox-vendors.paddle.com)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_STUDENT=
PADDLE_PRICE_ID_PRO=
