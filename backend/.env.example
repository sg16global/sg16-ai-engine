# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: https://sg16engine.com  http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
SG16_DEV_AUTH=0

# Public site URL (OpenRouter referrer + PWA)
SG16_APP_URL=https://sg16engine.com

# Railway sets PORT automatically
PORT=8000

SG16_AI_API_KEY=
SG16_ROUTER_API_KEY=
SG16_LIVE_SEARCH=1
