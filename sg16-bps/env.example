# SG16 sovereign stack — 100% Railway (site + Postgres + Ollama brain)
NODE_ENV=production
PORT=8000
HOST=0.0.0.0

# Sovereign brain — Mistral on Ollama inside the Railway container
SG16_BRAIN=ollama
OLLAMA_URL=http://127.0.0.1:11434
SG16_OLLAMA_MODEL=mistral:7b-instruct

SG16_CHAT_TIMEOUT_MS=120000
SG16_CODING_TIMEOUT_MS=180000
SG16_DEFAULT_TIMEOUT_MS=120000

# Auth (required for production login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=

# Public URL
SG16_APP_URL=https://sg16engine.com
SG16_LAUNCH_FREE=1

# Database — Railway Postgres plugin
DATABASE_URL=postgresql://user:pass@host:5432/sg16

# Dodo payments (when live)
# DODO_API_KEY=
# DODO_WEBHOOK_SECRET=

# Subdomain routing
# SG16_SHIELD_HOST=shield.sg16engine.com
