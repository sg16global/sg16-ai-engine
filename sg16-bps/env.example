# SG16 sovereign brain — copy to /opt/sg16/.env on the VPS
NODE_ENV=production
PORT=8000
HOST=0.0.0.0

# === SOVEREIGN MODE (Mistral on Ollama — Apache 2.0, no Groq rental brain) ===
SG16_BRAIN=ollama
OLLAMA_URL=http://127.0.0.1:11434
SG16_OLLAMA_MODEL=mistral:7b-instruct
# Keep Apache 2.0 license notice with model weights on server (/usr/share/ollama or docs).

# Slower CPU inference — allow longer replies
SG16_CHAT_TIMEOUT_MS=120000
SG16_CODING_TIMEOUT_MS=180000
SG16_DEFAULT_TIMEOUT_MS=120000

# Auth (required for production login)
GOOGLE_CLIENT_ID=

# Optional database (leave empty for no Postgres)
# DATABASE_URL=

# App URLs
SG16_APP_URL=https://sg16engine.com
