[Unit]
Description=SG16 AI Engine (sovereign Mistral + API)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=sg16
Group=sg16
WorkingDirectory=/opt/sg16/app
EnvironmentFile=/opt/sg16/.env
ExecStart=/usr/bin/node backend/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sg16-ai-engine

[Install]
WantedBy=multi-user.target
