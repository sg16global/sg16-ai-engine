# ── SG16 AI Engine — build-time configuration ────────────────────────────
# The app is fully self-contained: there is no backend server. AI providers
# are configured at runtime in the Admin panel (/admin) and stored on the
# device; the variables below are optional build-time defaults.
#
# Copy this file to .env (git-ignored) and fill in what you need.

# --- Default AI provider (optional) --------------------------------------
# Preset id: openai | qwen | deepseek | anthropic | gemini | groq | mistral |
#            xai | openrouter | ollama | custom
# VITE_SG16_AI_PROVIDER=qwen
# Override the preset's endpoint (empty = preset default):
# VITE_SG16_AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# API key for the provider (kept in the built app — prefer runtime Admin setup):
# VITE_SG16_AI_API_KEY=
# Model slots (empty = preset default):
# VITE_SG16_AI_MODEL=qwen-plus
# VITE_SG16_AI_CODING_MODEL=qwen-max
# VITE_SG16_AI_VISION_MODEL=qwen-vl-max

# --- Live web search ------------------------------------------------------
# 1 (default): time-sensitive questions get live news/web context via the
# edge functions (/api/edge/news, /api/edge/search). Set to 0 to disable.
# VITE_SG16_LIVE_SEARCH=1

# --- Local development ----------------------------------------------------
# `npm run dev` serves only the SPA. To test the edge functions locally:
#   npm run build && npx wrangler pages dev dist
# Deploy: connect this repo to Cloudflare Pages (build command: npm run build,
# output directory: dist) — the functions/ directory is deployed automatically.
