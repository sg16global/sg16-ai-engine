# Same Client ID as backend GOOGLE_CLIENT_ID (public — safe in frontend)
# Authorized origins in Google Console: https://sg16engine.com  https://www.sg16engine.com  http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

VITE_SG16_AI_KEY=

# --- API connection ---------------------------------------------------------
# Dev only: where `npm run dev` forwards /api and /health.
# Default http://localhost:8000 (the local backend). Use the live engine to run the UI without a backend:
# SG16_DEV_API_TARGET=https://sg16engine.com

# Build time: backend origin for builds served from another domain. Leave empty when the
# frontend is served by the backend itself (Railway, Capacitor app) — requests stay same-origin.
# The backend must allow this origin in CORS.
# VITE_API_BASE_URL=https://sg16engine.com
