{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sg16-engine-web",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },

  // The built website (npm run build --prefix project writes it here).
  // The worker runs first so app routes, 404s and /api forwarding match backend/server.js.
  "assets": {
    "directory": "../backend/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // The Node backend runs as a Cloudflare Container built from the repo Dockerfile.
  // "basic" = 1/4 vCPU, 1 GiB RAM, 4 GB disk. Use "standard-1" (4 GiB) if Coding Shield scans run out of memory.
  "containers": [
    {
      "class_name": "Backend",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }],

  "vars": {
    // Leave empty to use the container above. Set to an external backend URL to bypass it.
    "BACKEND_URL": "",
    "SHIELD_HOST": "shield.sg16engine.com",
    "SG16_APP_URL": "https://sg16engine.com"
  }

  // Backend secrets (set once with `npx wrangler secret put <NAME>`, passed into the container):
  //   JWT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SG16_OWNER_EMAIL,
  //   DATABASE_URL (Postgres — required, the container disk is wiped on restart),
  //   AI_API_URL, AI_API_KEY, AI_MODEL, AI_VISION_MODEL

  // When the site works on *.workers.dev, serve the real domains (delete their old DNS records
  // first), then deploy again:
  // "routes": [
  //   { "pattern": "sg16engine.com", "custom_domain": true },
  //   { "pattern": "www.sg16engine.com", "custom_domain": true },
  //   { "pattern": "shield.sg16engine.com", "custom_domain": true }
  // ]
}
